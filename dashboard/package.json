{
  "name": "exohunt-stellar-survey",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only EXOHUNT survey dashboard",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:statuses": "node ../scripts/generate_status_registry.mjs",
